# Local development — Flask on this machine
# CMS is Next.js — use NEXT_PUBLIC_API_URL (not VITE_API_URL).
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional: public website origin (for /assets/* previews in CMS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On Vercel, set:
# NEXT_PUBLIC_API_URL=https://aif-backend-6jwe.onrender.com
# NEXT_PUBLIC_SITE_URL=https://amp-aif.vercel.app
